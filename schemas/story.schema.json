{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nalajb/metafyl/schemas/story.schema.json",
  "title": "Story IR",
  "description": "Documents the shape of story.json for humans and external tooling. src/ir/validate.mjs implements the same checks by hand (this project has zero npm runtime dependencies, so no JSON Schema engine is used at runtime).",
  "type": "object",
  "required": ["schema_version", "session", "turns", "files", "totals"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generator": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "cwd": { "type": "string" },
        "git_branch": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "description": "Filled in by Claude; required non-empty in strict validation." },
        "blind_spots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "id", "prompt", "edits"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "id": { "type": "string" },
          "at": { "type": ["string", "null"], "format": "date-time" },
          "prompt": { "type": "string" },
          "summary": { "type": "string", "description": "Filled in by Claude; required non-empty in strict validation." },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "tool", "file", "rel", "hunks", "stats"],
              "properties": {
                "id": { "type": "string" },
                "tool": { "enum": ["Edit", "Write", "NotebookEdit"] },
                "file": { "type": "string" },
                "rel": { "type": "string" },
                "kind": { "type": ["string", "null"], "enum": ["create", "update", null] },
                "by_subagent": { "type": ["string", "null"] },
                "result": { "enum": ["ok", "unknown"] },
                "hunks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["oldStart", "oldLines", "newStart", "newLines", "lines"],
                    "properties": {
                      "oldStart": { "type": "integer" },
                      "oldLines": { "type": "integer" },
                      "newStart": { "type": "integer" },
                      "newLines": { "type": "integer" },
                      "lines": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "stats": {
                  "type": "object",
                  "required": ["added", "removed"],
                  "properties": {
                    "added": { "type": "integer", "minimum": 0 },
                    "removed": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "turns", "churn", "stats"],
        "properties": {
          "rel": { "type": "string" },
          "language": { "type": ["string", "null"] },
          "turns": { "type": "array", "items": { "type": "integer" } },
          "churn": { "type": "boolean", "description": "true when more than one turn touched this file" },
          "stats": {
            "type": "object",
            "required": ["added", "removed"],
            "properties": {
              "added": { "type": "integer", "minimum": 0 },
              "removed": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["turns", "files", "added", "removed", "edits"],
      "properties": {
        "turns": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "edits": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
