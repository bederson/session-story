                  "integer",
                  "null"
                ]
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cache_read_tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cache_creation_tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              },
