                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "cost_usd": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "null when the session has no cost-state yet, as when it was still running."
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "turns": {
          "type": "array",
          "description": "One entry per turn, in turn order: its duration, its main-thread tokens (from turns[].usage), the tokens of the subagents it spawned, and its share of the session. Shares are fractions rounded to 3 decimals and null when either side is unknown. They need not sum to 1: turn durations can come from the harness while the session duration is wall clock (including gaps across /clear), and session tokens prefer the cost-state record, which also counts the harness's background calls. Never a per-turn cost.",
