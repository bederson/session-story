                  "integer",
                  "null"
                ]
              },
              "complete": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "null when the turn carried no usage."
              },
              "subagents": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Subagents this turn spawned; null when none. Token fields are null when none of them carried usage.",
